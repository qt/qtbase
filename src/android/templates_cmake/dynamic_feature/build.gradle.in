plugins {
    alias(libs.plugins.android.dynamic.feature)
}

dependencies {
    @GRADLE_DEPENDENCIES@
}

android {
    namespace = '@PACKAGE_NAME@'
    compileSdk {
        version = release(@ANDROID_COMPILE_SDK_RELEASE@) {
            minorApiLevel = @ANDROID_COMPILE_SDK_MINOR@
        }
    }
    buildToolsVersion = '@ANDROID_BUILD_TOOLS_VERSION@'
    ndkVersion = '@ANDROID_NDK_REVISION@'

    defaultConfig {
        @DEFAULT_CONFIG_VALUES@
        manifestPlaceholders = [
            featureTitle: "@string/${project.name}_title"
        ]
    }

    sourceSets {
        main {
            @SOURCE_SETS@
        }
    }

    tasks.withType(JavaCompile).configureEach {
        options.compilerArgs += ['-Xlint:all']
    }

    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }

    androidResources {
        noCompress += ['rcc'] // Do not compress Qt binary resources file
    }

    @ANDROID_DEPLOYMENT_EXTRAS@
}
