#version 430

// Single-thread shader: writes a single uint32_t (the draw count to be
// consumed by drawIndirectCount/drawIndexedIndirectCount) into a buffer that
// also serves as a count buffer for the next render pass.

layout (local_size_x = 1) in;

layout(std430, binding = 0) buffer CountBuf
{
    uint count;
} buf;

layout(std140, binding = 1) uniform CountIn
{
    uint value;
} ubuf;

void main()
{
    buf.count = ubuf.value;
}
